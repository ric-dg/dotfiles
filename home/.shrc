# ~/.shrc: interactive dash/sh (via $ENV from ~/.profile). Kept small: dash is
# your login shell for speed; fish is for daily interactive work.
case $- in *i*) ;; *) return 0 2>/dev/null || exit 0 ;; esac

# user@host:dir$  (read is a builtin: no process; dash re-expands $PWD per prompt; before set -o emacs,
# which breaks read-from-file in dash)
[ -n "${HOSTNAME:-}" ] || read -r HOSTNAME </etc/hostname
PS1='$USER@$HOSTNAME:$PWD\$ '

set -o emacs                       # arrow keys, history, Ctrl-A/E/L (libedit)
HISTSIZE=2000

alias ls='eza --group-directories-first' ll='eza -l --git --group-directories-first'
alias v=nvim g=git grep='grep --color=auto'
t() { tmux new-session -A -s "${1:-main}"; }   # attach or create a tmux session

# generated by `csw init sh` (see github.com/ric-dg/csw), if csw is installed
[ -r ~/.config/sh/csw.sh ] && . ~/.config/sh/csw.sh
# machine-specific aliases and secrets-free tweaks: untracked, never in this repo
[ -r ~/.config/sh/local.sh ] && . ~/.config/sh/local.sh
