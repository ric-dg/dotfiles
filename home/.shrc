# ~/.shrc: interactive dash/sh (via $ENV from ~/.profile). Kept small: dash is
# your login shell for speed; fish is for daily interactive work.
case $- in *i*) ;; *) return 0 2>/dev/null || exit 0 ;; esac

# user@host:dir$  (read is a builtin: no process; dash re-expands $PWD per prompt; before set -o emacs,
# which breaks read-from-file in dash)
[ -n "${HOSTNAME:-}" ] || read -r HOSTNAME </etc/hostname
PS1='$USER@$HOSTNAME:$PWD\$ '

set -o emacs                       # arrow keys, history, Ctrl-A/E/L (libedit)
HISTSIZE=2000

alias ls='eza --group-directories-first' ll='eza -l --git --group-directories-first'
alias v=nvim g=git grep='grep --color=auto'
t() { tmux new-session -A -s "${1:-main}"; }   # attach or create a tmux session

# optional: csw's fast `claude` function (github.com/ric-dg/csw), if it is installed
[ -r ~/.config/sh/csw.sh ] && . ~/.config/sh/csw.sh
# machine-specific aliases and secrets-free tweaks: untracked, never in this repo
[ -r ~/.config/sh/local.sh ] && . ~/.config/sh/local.sh

# dotfiles: once per boot, name tools the dotfiles expect but this machine lacks. The list
# is written by install.sh; each entry is re-checked here with builtins (no forks), so a
# tool installed since then is not reported.
_dm=${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/missing
_dw=${XDG_RUNTIME_DIR:-/tmp}/dotfiles-warned
if [ -s "$_dm" ] && [ ! -e "$_dw" ]; then
	_dl='' _dx=''
	read -r _dl <"$_dm" || true
	_dr=dotfiles
	[ ! -r "${_dm%/missing}/repo" ] || read -r _dr <"${_dm%/missing}/repo" || true
	for _dc in $_dl; do
		_dok=0 _dIFS=$IFS IFS='|'
		for _da in $_dc; do command -v "$_da" >/dev/null 2>&1 && _dok=1; done
		IFS=$_dIFS
		[ "$_dok" = 1 ] || _dx="$_dx ${_dc%%|*}"
	done
	[ -z "$_dx" ] || printf 'dotfiles: missing%s (install: %s/install.sh tools)\n' "$_dx" "$_dr" >&2
	: >"$_dw" 2>/dev/null || true
fi
unset _dm _dw _dl _dx _dc _da _dok _dIFS _dr
